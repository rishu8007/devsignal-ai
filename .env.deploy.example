# Copy to .env.deploy and replace every placeholder. Keep the copy private.
PUBLIC_DOMAIN=notes.example.com
PUBLIC_ORIGIN=https://notes.example.com
NEXT_PUBLIC_API_BASE_URL=/api/v1
TRUST_PROXY_HOPS=1

MONGO_ROOT_USERNAME=devsignal_deploy_admin
MONGO_ROOT_PASSWORD=replace_with_a_long_alphanumeric_password

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=devsignal-api
JWT_AUDIENCE=devsignal-web
AUTH_COOKIE_NAME=devsignal_access_token

AI_INTERNAL_API_KEY=replace_with_the_same_strong_key_for_api_and_ai_at_least_32_characters
AI_SERVICE_TIMEOUT_MS=150000

# Optional LinkedIn integration. Leave disabled and blank to keep the card
# unconfigured. Enabling it requires every provider value below.
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://notes.example.com/api/v1/connections/linkedin/callback
LINKEDIN_TOKEN_ENCRYPTION_KEY=
LINKEDIN_SCOPES=openid profile email
LINKEDIN_POSTING_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601
LINKEDIN_PUBLISHING_ENABLED=false
LINKEDIN_SCHEDULER_ENABLED=false
LINKEDIN_SCHEDULE_HORIZON_DAYS=90
LINKEDIN_SCHEDULE_LATE_WINDOW_MINUTES=60

# Optional GitHub App integration. Leave disabled and blank to keep the card
# unconfigured. Use the PEM private key content exactly as issued by GitHub.
GITHUB_ENABLED=false
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REDIRECT_URI=https://notes.example.com/api/v1/connections/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_INTERVAL_MINUTES=15
GITHUB_SYNC_MAX_PAGES_PER_PASS=3
GITHUB_INITIAL_HISTORY_DAYS=90

# Durable LangGraph workflow checkpoints use the private deployment MongoDB
# network and a separate database from application data.
WORKFLOW_CHECKPOINT_DATABASE=devsignal_workflows

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
QDRANT_COLLECTION_NAME=devsignal_knowledge_chunks
QDRANT_TIMEOUT_SECONDS=10
OPENAI_TIMEOUT_SECONDS=45
