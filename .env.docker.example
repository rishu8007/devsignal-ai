# Copy to .env.docker and replace every placeholder before starting the app profile.
# Keep this file local and never commit the copied file.
MONGO_ROOT_USERNAME=devsignal_admin
MONGO_ROOT_PASSWORD=replace_with_a_local_alphanumeric_password
MONGO_PORT=27017
QDRANT_PORT=6333

WEB_PORT=3000
API_PORT=4000
AI_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=devsignal-api
JWT_AUDIENCE=devsignal-web
AUTH_COOKIE_NAME=devsignal_access_token
AI_INTERNAL_API_KEY=replace_with_the_same_strong_key_for_api_and_ai_at_least_32_characters
AI_SERVICE_TIMEOUT_MS=150000

OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
QDRANT_COLLECTION_NAME=devsignal_knowledge_chunks
QDRANT_TIMEOUT_SECONDS=10
OPENAI_TIMEOUT_SECONDS=45
