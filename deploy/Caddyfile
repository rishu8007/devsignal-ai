{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Caddy replaces untrusted incoming X-Forwarded-* values by default.
	# The API is reachable only through this single ingress service.
	request_body {
		max_size 2MB
	}

	@api path /api/v1 /api/v1/*
	reverse_proxy @api api:4000 {
		flush_interval -1
	}

	reverse_proxy web:3000 {
		flush_interval -1
	}
}
