APP_ENV=development
HOST=127.0.0.1
PORT=8000
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=devsignal_knowledge_chunks_gemini_v1
QDRANT_TIMEOUT_SECONDS=10
INTERNAL_API_KEY=replace_with_a_strong_internal_service_key
GEMINI_TIMEOUT_SECONDS=45
# Optional: set a MongoDB URI to enable durable workflow checkpoints.
# Use a separate database from the application data and extend backup coverage
# before enabling workflows in production.
WORKFLOW_CHECKPOINT_URI=
WORKFLOW_CHECKPOINT_DATABASE=devsignal_workflow_checkpoints
