NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://devsignal_admin:replace_with_a_local_alphanumeric_password@127.0.0.1:27017/devsignal?authSource=admin
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=3600
JWT_ISSUER=devsignal-api
JWT_AUDIENCE=devsignal-web
AUTH_COOKIE_NAME=devsignal_access_token
AI_SERVICE_URL=http://127.0.0.1:8000
AI_INTERNAL_API_KEY=replace_with_a_strong_internal_service_key
AI_SERVICE_TIMEOUT_MS=150000
AI_DAILY_OPERATION_LIMIT=100
AI_APPLICATION_DAILY_OPERATION_LIMIT=10000
AI_USAGE_FAIL_CLOSED=true
# Optional JSON map: {"model-name":{"input":1,"output":2,"embedding":0.1}}
AI_MODEL_PRICING_JSON=
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
