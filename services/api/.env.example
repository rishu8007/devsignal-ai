LINKEDIN_SCOPES=openid profile email
LINKEDIN_POSTING_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202601
LINKEDIN_PUBLISHING_ENABLED=false
LINKEDIN_SCHEDULER_ENABLED=false
LINKEDIN_SCHEDULE_HORIZON_DAYS=90
LINKEDIN_SCHEDULE_LATE_WINDOW_MINUTES=60
